# Where driver data comes from: live | replay | mock
#   mock   - generated data, no network. The default, and what CI uses.
#   live   - OpenF1 live timing. Needs OPENF1_API_TOKEN (paid Sponsor tier).
#   replay - a cached historical race. Arrives in Phase 1.
DATA_MODE=mock

# Serve mock data per request instead of from a background poll loop. Required
# on serverless hosts (Vercel, Lambda), which freeze the process between
# requests so the poll loop never advances. Defaults on when VERCEL is set, off
# everywhere else - Docker and `uvicorn` keep the long-running loop.
# DEMO_STATELESS=false
# Ticks of the mock race replayed per request when stateless. Must be at least
# BATTLE_GAP_TREND_WINDOW * 3, or no battle accumulates enough distinct gap
# samples to clear the stability filter and the board stays empty.
# DEMO_WINDOW_TICKS=48

# OpenF1 API Configuration
OPENF1_BASE_URL=https://api.openf1.org/v1
# Only needed for DATA_MODE=live. Historical data is free and needs no token.
OPENF1_API_TOKEN=
OPENF1_TIMEOUT_S=5.0
# A CA bundle to verify OpenF1's certificate against, instead of the one httpx
# ships. Needed only behind something that intercepts TLS - a corporate proxy,
# or consumer antivirus doing HTTPS scanning - which presents its own
# certificate and so fails verification.
# OPENF1_CA_BUNDLE=C:\ProgramData\Norton\Antivirus\wscert.pem
OPENF1_MAX_RETRIES=3

# Replay cache (Phase 1)
# Where `python -m app.ingest` writes cached races, and where replay reads
# them. A relative path resolves against backend/, not the working directory.
REPLAY_DATA_DIR=./data/sessions
# Minutes after a session ends before ingest will fetch it. OpenF1's free
# archive settles once the live window closes (+30 min); the rest is buffer.
# INGEST_MIN_SESSION_AGE_MIN=45
# Pause between the sequential endpoint fetches of one ingest run. OpenF1
# publishes no free-tier rate limit, so politeness is the whole strategy.
# INGEST_REQUEST_PAUSE_S=1.0
# A stretch of race time with no events at all longer than this is a stoppage
# (red flag). Playback compresses it instead of showing a frozen screen.
# REPLAY_QUIET_GAP_S=60.0
# Laps without a position or interval row before a car counts as retired and
# is dropped from the running order.
# REPLAY_RETIREMENT_LAPS=2
# Session keys to play, comma separated, looping forever. Unset plays every
# cached race, oldest first.
# REPLAY_PLAYLIST=9928
# Race seconds per wall second: 1, 5, 10 or 20.
# REPLAY_SPEED=1
# When the playlist started. Where the broadcast is depends only on this and
# the wall clock, so every viewer and every instance agrees.
# REPLAY_EPOCH=2026-01-01T00:00:00+00:00
# Ticks detected per request on the stateless path, after 60 ticks of
# history warm-up.
# REPLAY_WINDOW_TICKS=48
# Wall seconds a red-flag stoppage is played back in.
# REPLAY_QUIET_PLAYBACK_S=5.0

# Polling Intervals (seconds)
POLL_POSITIONS_INTERVAL_S=1.5
POLL_LAPS_INTERVAL_S=10.0
POLL_SESSION_INTERVAL_S=30.0

# Battle Detection Parameters
BATTLE_GAP_TREND_WINDOW=6
BATTLE_PACE_TREND_WINDOW=3
BATTLE_MIN_DURATION_UPDATES=3
BATTLE_MAX_GAP_S=3.0

# Battle Thresholds
BATTLE_WATCH_SCORE=0.55
BATTLE_WATCH_GAP_S=1.8
BATTLE_HOT_SCORE=0.70
BATTLE_HOT_GAP_S=1.2

# Data Quality
DATA_STALE_THRESHOLD_S=5.0
DATA_CONFIDENCE_MEDIUM_S=3.0

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Preview deployments get a new hostname on every push, which no fixed list can
# cover. Set by backend/vercel.json when deployed; leave unset locally.
# CORS_ORIGIN_REGEX=https://[A-Za-z0-9-]+\.vercel\.app

# Storage (optional)
SQLITE_DB_PATH=./data/f1_sessions.db
SNAPSHOT_INTERVAL_S=30.0

# Logging
LOG_LEVEL=INFO

# Deprecated: superseded by DATA_MODE above. Still honoured when DATA_MODE is
# unset (true -> mock, false -> live), with a DeprecationWarning at startup.
# TEST_MODE=false
